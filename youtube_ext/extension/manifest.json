{
  "manifest_version": 3,
  "name": "Ask this video",
  "version": "1.0.0",
  "description": "Ask questions about the YouTube video you are watching.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ask this video"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ]
}